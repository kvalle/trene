{
  "expo": {
    "name": "Trene",
    "slug": "trene",
    "version": "0.1.0",
    "icon": "./assets/app-icon.png",
    "orientation": "default",
    "userInterfaceStyle": "automatic",
    "locales": {
      "nb": "./locales/nb.json"
    },
    "ios": {
      "bundleIdentifier": "com.kjetilvalle.trene",
      "deploymentTarget": "26.0",
      "supportsTablet": false
    },
    "android": {
      "package": "com.kjetilvalle.trene",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon-foreground.png",
        "backgroundColor": "#155e4b",
        "monochromeImage": "./assets/adaptive-icon-foreground.png"
      }
    },
    "plugins": [
      "expo-sqlite",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 34,
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "useDayNightTheme": true
          },
          "ios": {
            "deploymentTarget": "26.0"
          }
        }
      ]
    ]
  }
}
