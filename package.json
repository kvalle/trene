{
  "name": "trene",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "start:android": "sh scripts/start-android-metro.sh",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "build:ios:smoke": "bash scripts/build-ios-smoke-app.sh",
    "smoke:ios": "bash scripts/run-ios-smoke.sh",
    "smoke:android": "sh scripts/run-android-smoke.sh",
    "smoke:android:backup": "bash scripts/run-android-backup-smoke.sh",
    "qualify:android": "sh scripts/run-android-qualification.sh",
    "qualify:backup:record": "node scripts/validate-backup-qualification.mjs",
    "qualify:backup:android": "bash scripts/qualify-backup-android.sh",
    "qualify:backup:fixture": "node scripts/create-backup-performance-fixture.mjs --output .artifacts/backup-qualification/fixture",
    "test": "jest --runInBand",
    "typecheck": "tsc --noEmit",
    "verify": "npm run typecheck && npm test -- --ci && mkdir -p .artifacts/expo && __UNSAFE_EXPO_HOME_DIRECTORY=$PWD/.artifacts/expo expo-doctor"
  },
  "dependencies": {
    "@noble/hashes": "^1.8.0",
    "@react-navigation/native": "^7.3.14",
    "@react-navigation/native-stack": "^7.18.6",
    "expo": "~57.0.11",
    "expo-asset": "~57.0.11",
    "expo-build-properties": "~57.0.9",
    "expo-constants": "~57.0.11",
    "expo-file-system": "~57.0.4",
    "expo-haptics": "~57.0.1",
    "expo-sharing": "~57.0.12",
    "expo-sqlite": "~57.0.1",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.2",
    "fflate": "^0.8.3",
    "graphemer": "^1.4.0",
    "react": "19.2.3",
    "react-native": "0.86.2",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0"
  },
  "devDependencies": {
    "@testing-library/react-native": "~13.3.3",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.2",
    "expo-doctor": "^1.20.1",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.3",
    "react-test-renderer": "19.2.3",
    "typescript": "~6.0.3"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
